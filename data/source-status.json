    "src_meraki_ios_xe": {
      "id": "src_meraki_ios_xe",
      "url": "https://documentation.meraki.com/Switching/Cloud_Management_with_IOS_XE/Product_Information/Overviews_and_Datasheets/Cloud_Management_with_IOS_XE_Overview",
      "ultimoControllo": "2026-08-01T08:15:50.127Z",
      "httpStatus": 200,
      "raggiungibile": true,
      "hash": "d2012a4f2cb03a5150df3b9be456b2c91e9340aacf0301d342c71e25947bf64f",
      "cambiataDaUltimoControllo": false,
      "errore": null,
      "aggiornamentoAutomatico": {
        "esito": "applicato",
        "citazioni": [
          "famiglie/fam_catalyst.descrizione: \"Cloud Management with IOS XE offers flexibility of choosing the configuration source for your switches: cloud or device. With cloud configuration, you can use Meraki dashboard and Meraki APIs to configure your switches. With device configuration, you are able to configure your switch locally via the CLI or using other tools. In IOS XE 17.18.1 we introduced support for features like BGP, VRF, In-Service Software Upgrades, and expanded support for the entire Catalyst 9200,9300, and C9500 High Performance families. Now with IOS XE 17.18.2, we are introducing brand new cloud EVPN fabric capabilities, Virtual Router Redundancy Protocol (VRRP) support. Support for Cisco Catalyst switch platforms running IOS XE has been extended to the Meraki India, Meraki China, and Meraki Canada regional clouds.\"",
          "integrazioni/int_catalyst_meraki.note: \"Eligible devices can migrate to cloud management using your existing DNA license - no additional license migration or transfer required until February 1, 2029. Support for Cisco Catalyst switch platforms running IOS XE has been extended to the Meraki India, Meraki China, and Meraki Canada regional clouds. device configuration (previously referred to as cloud monitoring)\""
        ]
      },
      "categoriaControllo": "release",
      "intervalloGiorniConsigliato": 7
    },
